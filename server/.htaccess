<IfModule mod_headers.c>
    # อนุญาตให้ทุก Origin เข้าถึงได้ (สามารถเปลี่ยน "*" เป็นโดเมนของ React ได้ เช่น "http://localhost:5173")
    Header set Access-Control-Allow-Origin "*"
    
    # อนุญาต Method ที่จำเป็น (GET, POST, OPTIONS, PUT, DELETE)
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    
    # อนุญาต Headers ที่จำเป็น
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, Origin, X-Requested-With"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # จัดการกับ OPTIONS pre-flight request
    # ถ้ามี request แบบ OPTIONS เข้ามา ให้ตอบกลับ 200 OK ทันที (เพื่อบอก Browser ว่าอนุญาต)
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>